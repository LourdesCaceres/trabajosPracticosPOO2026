comment2.target=Rectangulo(Punto, double, double)
comment2.text=\r\n 2do CONSTRUCTOR de la clase Rectangulo\: para el caso ...\r\n \r\n @param p_origen\r\n @param p_ancho\r\n @param p_alto\r\n
